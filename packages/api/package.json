{
  "name": "@goldsmith/api",
  "version": "0.0.0",
  "private": true,
  "description": "Node + TypeScript API (Express). Server code arrives from EP-03 onward.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:migrate": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts migrate",
    "db:status": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts status",
    "db:reset": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts reset",
    "db:seed": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts seed",
    "db:dev-session": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts dev-session",
    "db:dev-password": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts dev-password",
    "db:create": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/db/cli.ts create",
    "db:new": "node --conditions=@goldsmith/source --import tsx src/db/cli.ts new",
    "storage:create": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/files/storage-cli.ts create",
    "backup:db": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts backup-db",
    "backup:list": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts backup-list",
    "backup:check": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts backup-check",
    "backup:prune": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts backup-prune",
    "restore:db": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts restore-db",
    "restore:drop": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts restore-drop",
    "check:audit": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts check-audit",
    "restore:sends": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts restore-sends",
    "backup:files": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts backup-files",
    "restore:files": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts restore-files",
    "check:files": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts check-files",
    "drill:run": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts drill-run",
    "drill:record": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx src/ops/cli.ts drill-record",
    "live:demo": "node --conditions=@goldsmith/source --env-file-if-exists=../../.env --import tsx scripts/live-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@goldsmith/shared": "0.0.0",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
