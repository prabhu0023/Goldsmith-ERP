# Every configuration value the product reads. Names only: never put a real value in this file.
# Local development: copy to .env (git-ignored) and fill in. Staging and production: set these
# in the hosting provider's secret store (D1a), one separate set per environment.

# Which environment this is: development, staging or production. Required.
APP_ENV=
# Public URL of the web app, e.g. http://localhost:3000 locally. Required.
APP_URL=
# Secret used to sign sessions, at least 32 characters (e.g. `openssl rand -hex 32`). Required.
SESSION_SECRET=
# Development lane for a second worktree on the same machine (docs/setup/parallel-lanes.md): one
# letter, a to z. Unset = the default single-developer setup. LANE=a uses databases goldsmith_dev_a
# and goldsmith_a_test (from DATABASE_URL and TEST_DATABASE_URL below) and ports api 4001, web 3001;
# LANE=b: goldsmith_dev_b, goldsmith_b_test, api 4002, web 3002. Optional; development only.
LANE=
# Port the api listens on. Optional, defaults to 4000 (4000 + n in lane n: a = 4001, b = 4002).
API_PORT=
# Port of the web dev server (npm run dev). Optional, defaults to 3000 (3000 + n in lane n).
WEB_PORT=
# Largest request body the api accepts, in bytes; bigger requests are refused. Optional, defaults to 102400 (100 kB).
API_MAX_BODY_BYTES=
# Hours a create's idempotency key and result are kept, so a retry within that time returns the
# first result. Optional, defaults to 24. (Cleanup scheduling arrives with EP-10.)
IDEMPOTENCY_RETENTION_HOURS=
# Sign-in (EP-04). How activation and reset emails are sent: stub keeps them in the api's memory,
# readable at <api>/dev/mailbox (development and staging only). Optional; unset = stub outside
# production, and no account email at all in production (stub is refused there).
ACCOUNT_EMAIL_MODE=
# Minutes without an accepted request after which a session ends. Optional, defaults to 720 (12 h).
SESSION_IDLE_MINUTES=
# Length of the sign-in and reset rate-limit window, in minutes. Optional, defaults to 15.
AUTH_RATE_WINDOW_MINUTES=
# Sign-in attempts allowed per phone number per window. Optional, defaults to 10.
AUTH_SIGN_IN_PER_PHONE=
# Sign-in attempts allowed per device (client address) per window. Optional, defaults to 30.
AUTH_SIGN_IN_PER_DEVICE=
# Password-reset requests allowed per phone number per window. Optional, defaults to 3.
AUTH_RESET_PER_PHONE=
# Password-reset requests allowed per device (client address) per window. Optional, defaults to 10.
AUTH_RESET_PER_DEVICE=
# Hosting region: an India region (D10); the exact name follows the D1a cloud provider. Optional.
CLOUD_REGION=
# PostgreSQL connection string for this environment's database (used from EP-02). Optional for now.
# Local: postgres://postgres:postgres@localhost:5432/goldsmith_dev (docker-compose.yml, local-only credentials)
DATABASE_URL=
# The api's own connection, as role goldsmith_app: it can read and add audit entries but never
# change or remove them (EP-06, FU-001). Migrations, seed and reset keep DATABASE_URL. LANE applies
# like DATABASE_URL. Optional in development (unset = the api uses DATABASE_URL and warns);
# staging and production refuse to start without a connection that cannot change audit entries.
# Local: postgres://goldsmith_app:localapp@localhost:5432/goldsmith_dev (npm run db:create gives it login)
APP_DATABASE_URL=
# The api's database pool gives up opening a connection, or waiting for a free one, after this
# many milliseconds. Optional, defaults to 5000. (/health uses its own 2000 ms probe connection.)
DATABASE_CONNECT_TIMEOUT_MS=
# The api's database pool cancels a statement (statement_timeout) and stops waiting for its answer
# (query_timeout) after this many milliseconds. Optional, defaults to 30000. Not applied to db:migrate.
DATABASE_QUERY_TIMEOUT_MS=
# Run the background job scheduler (EP-10) in this api process: true or false. Optional, defaults to true.
JOBS_ENABLED=
# How often the scheduler looks for due jobs, in milliseconds, 1000 to 60000. Optional, defaults to 15000.
JOBS_POLL_INTERVAL_MS=
# Database the api tests may wipe; its name must end in _test or the tests refuse to run.
# Local: postgres://postgres:postgres@localhost:5432/goldsmith_test.
# Unset = database tests are skipped (CI always sets it).
TEST_DATABASE_URL=
# Object storage bucket for photos and documents. Optional for now.
STORAGE_BUCKET=
# Object storage access key id. Optional for now.
STORAGE_ACCESS_KEY_ID=
# Object storage secret access key. Optional for now.
STORAGE_SECRET_ACCESS_KEY=
# S3-compatible object storage endpoint (EP-09, docs/setup/files.md). Optional; unset = the provider's
# default endpoint. Local: http://localhost:8333 (npm run storage:up), with STORAGE_BUCKET=goldsmith-files
# and the local-only keys in docker/seaweedfs/s3.json. With LANE set, the bucket gets the lane added
# (goldsmith-files-b), and the tests use <bucket>-test (goldsmith-files-b-test).
STORAGE_ENDPOINT=
# Object storage region. Optional, defaults to us-east-1 (an India region in production, D10).
STORAGE_REGION=
# Largest uploaded file, in bytes. Optional, defaults to 10485760 (10 MB).
FILE_MAX_BYTES=
# Seconds a signed file link stays valid. Optional, defaults to 900 (15 min).
FILE_LINK_TTL_SECONDS=
# Days a purchase-order file is kept before the daily retention run removes it. Optional, defaults to 365.
FILE_RETENTION_PO_DAYS=
# Days a photo, reference or bench file is kept. Optional; unset = kept forever.
FILE_RETENTION_STANDARD_DAYS=
# WhatsApp Business provider phone number id. Optional for now.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business provider access token. Optional for now.
WHATSAPP_ACCESS_TOKEN=
# Email inbox (IMAP) host for incoming orders. Optional for now.
EMAIL_IMAP_HOST=
# Email inbox user name. Optional for now.
EMAIL_IMAP_USER=
# Email inbox password or app password. Optional for now.
EMAIL_IMAP_PASSWORD=
# LLM key (Google Gemini). Optional for now.
GEMINI_API_KEY=
# web dev server only: set to true to switch off hot reload and file watching. Optional.
DISABLE_HMR=
