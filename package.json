{
  "name": "goldsmith-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/api"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,magenta --kill-others \"npm run dev -w @goldsmith/web\" \"npm run dev -w @goldsmith/api\"",
    "build": "npm run build --workspaces",
    "lint": "biome lint && node scripts/check-shared-duplicates.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "concurrently": "^10.0.7",
    "esbuild": "^0.27.0",
    "typescript": "^7.0.2"
  }
}
