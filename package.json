{
  "name": "goldsmith-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/api"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,magenta --kill-others \"npm run dev -w @goldsmith/web\" \"npm run dev -w @goldsmith/api\"",
    "build": "npm run build --workspaces",
    "lint": "biome lint && node scripts/check-shared-duplicates.mjs && node scripts/check-bundled-images.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @goldsmith/api",
    "db:status": "npm run db:status -w @goldsmith/api",
    "db:seed": "npm run db:seed -w @goldsmith/api",
    "db:reset": "npm run db:reset -w @goldsmith/api",
    "db:dev-session": "npm run db:dev-session -w @goldsmith/api --",
    "db:dev-password": "npm run db:dev-password -w @goldsmith/api --",
    "db:create": "npm run db:create -w @goldsmith/api",
    "db:new": "npm run db:new -w @goldsmith/api --",
    "storage:up": "docker compose up -d --wait objectstore",
    "storage:create": "npm run storage:create -w @goldsmith/api",
    "backup:db": "npm run backup:db -w @goldsmith/api --",
    "backup:list": "npm run backup:list -w @goldsmith/api --",
    "backup:check": "npm run backup:check -w @goldsmith/api --",
    "backup:prune": "npm run backup:prune -w @goldsmith/api --",
    "restore:db": "npm run restore:db -w @goldsmith/api --",
    "restore:drop": "npm run restore:drop -w @goldsmith/api --",
    "check:audit": "npm run check:audit -w @goldsmith/api --",
    "restore:sends": "npm run restore:sends -w @goldsmith/api --",
    "backup:files": "npm run backup:files -w @goldsmith/api --",
    "restore:files": "npm run restore:files -w @goldsmith/api --",
    "check:files": "npm run check:files -w @goldsmith/api --",
    "drill:run": "npm run drill:run -w @goldsmith/api --",
    "drill:record": "npm run drill:record -w @goldsmith/api --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "concurrently": "^10.0.7",
    "esbuild": "^0.27.0",
    "typescript": "^7.0.2"
  }
}
